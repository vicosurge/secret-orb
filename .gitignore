Cargo.lock
target/

# Pascal compiled files
pascal/bin/
pascal/dist/
pascal/*.tar.gz
pascal/*.zip
*.o
*.ppu

# Compiled executables (but allow FPC installer)
pascal/bin/*.exe
!fpc-*.exe

# Release staging directory (make release / make sizecheck)
pascal/release/

# DOS floppy image (make dos-dist)
pascal/*.img
